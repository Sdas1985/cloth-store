# ==============================================================================
# ROXY CLOTH STORE (BANGLADESH) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxx.mongodb.net/roxy_cloth_store?retryWrites=true&w=majority
# Example for Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/roxy_cloth_store
# Note: If left unset, the backend automatically uses an optimized in-memory store for instant localhost preview.
MONGODB_URI=mongodb://127.0.0.1:27017/roxy_cloth_store

# Express Backend Server Port
PORT=5000

# Next.js Public & Backend API URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:5000

# Admin Secret Key
ADMIN_JWT_SECRET=roxy_super_secret_jwt_key_bangladesh_fashion_2026

# Node Environment
NODE_ENV=development
